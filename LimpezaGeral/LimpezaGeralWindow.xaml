<Window x:Class="BimBlaster.LimpezaGeral.LimpezaGeralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="#F4F5F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" BorderBrush="#E1E3E8" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,18">
            <Grid>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PluginTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#1B5563">
                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16" Foreground="#1E2430">
                        <Run Text="BIM" FontWeight="Bold"/><Run Text=" BLASTER" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Parâmetros -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblSheets" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtSheets" Text="CAPA_Não_Deletar" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="LblViews" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtViews" Text="Capa" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="LblSchedules" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtSchedules" Text=".FORROS" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="LblLinePatterns" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLinePatterns" Text="IMPORT" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LblExtra" Style="{StaticResource SectionLabelStyle}"/>
                        <CheckBox x:Name="ChkDwg" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkLinks" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkCollections" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkGroups" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkFamilies" IsChecked="True" Margin="0,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="100" Click="BtnCancel_Click"/>
            <Button x:Name="BtnRun" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Click="BtnRun_Click"/>
        </StackPanel>
    </Grid>
</Window>
